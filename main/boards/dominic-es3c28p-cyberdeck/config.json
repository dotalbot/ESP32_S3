{
  "type": "dominic-es3c28p-cyberdeck",
  "target": "esp32s3",
  "builds": [
    {
      "name": "dominic-es3c28p-cyberdeck",
      "sdkconfig_append": [
        "CONFIG_BT_ENABLED=y",
        "CONFIG_BT_NIMBLE_ENABLED=y",
        "CONFIG_BT_NIMBLE_ROLE_CENTRAL=n",
        "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n",
        "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n",
        "CONFIG_BT_NIMBLE_ROLE_OBSERVER=y",
        "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
        "CONFIG_USE_EMOTE_MESSAGE_STYLE=n",
        "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=n",
        "CONFIG_LV_USE_KEYBOARD=y"
      ]
    }
  ]
}
